# =====================================================================
# .env.example
#
# 사용법: cp .env.example .env 후 값을 채운다.
# .env는 .gitignore에 포함되어 있다.
# =====================================================================

# --- docker-compose가 직접 쓰는 값 ---
MYSQL_ROOT_PASSWORD=<CHANGE_ME>
MYSQL_PORT=3306
REDIS_PORT=6379

# --- app 컨테이너(application.yml)가 쓰는 값 ---
# DB_HOST/REDIS_HOST는 컨테이너 간 통신이므로 서비스명(mysql, redis) 그대로 둔다.
# DB_APP_PASSWORD는 src/db/.env의 APP_PASSWORD와 반드시 동일한 값이어야 한다.
# (마이그레이션이 그 값으로 shortlink_app 계정을 생성하고, 앱은 이 값으로 로그인을 시도한다)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shortlink
DB_APP_USER=shortlink_app
DB_APP_PASSWORD=<CHANGE_ME>
REDIS_HOST=redis
REDIS_PORT=6379
