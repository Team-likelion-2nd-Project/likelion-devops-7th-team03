apiVersion: batch/v1
kind: Job
metadata:
  name: k6-load-test
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: k6
          image: grafana/k6:latest
          args:
            - run
            - --out
            - experimental-prometheus-rw
            - /scripts/${SCRIPT_FILE}
          env:
            - name: BASE_URL
              value: "${BASE_URL}"
            - name: SLUG
              value: "${SLUG}"
            - name: SLUGS
              value: "${SLUG}"
            - name: VUS
              value: "${VUS}"
            - name: DURATION
              value: "${DURATION}"
            - name: K6_PROMETHEUS_RW_SERVER_URL
              value: "http://kube-prometheus-kube-prome-prometheus.monitoring.svc:9090/api/v1/write"
          volumeMounts:
            - name: script
              mountPath: /scripts
      volumes:
        - name: script
          configMap:
            name: k6-load-test-script
